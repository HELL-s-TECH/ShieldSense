# Copy this file to .env and fill in your own key.
# .env is gitignored — it never gets committed.
#
# Without this set, the reasoning tier falls back to a template-based
# explanation (see detector/reasoner.py) — the app still works, it's
# just less specific for ambiguous cases.
#
# Set exactly one of these (a gsk_... key is auto-detected as Groq even if
# pasted into the wrong variable name below):
GROQ_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
